      ],
      "id": "29c223e2-f44b-4089-94ff-f01b08146f75",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.output || \"\";\n\nconst blocks = text\n  .split(/\\n\\s*\\n/)\n  .map(block => block.trim())\n  .filter(Boolean);\n\nconst leads = blocks.map(block => {\n  const getValue = (label) => {\n    const regex = new RegExp(`${label}:\\\\s*(.*)`, \"i\");\n    const match = block.match(regex);\n    return match ? match[1].trim() : \"Not provided\";\n  };\n\n  return {\n    json: {\n      company_name: getValue(\"Company Name\"),\n      industry: getValue(\"Industry\"),\n      lead_score: Number(getValue(\"Lead Score\")) || 0,\n      lead_status: getValue(\"Lead Status\"),\n      reason: getValue(\"Reason\")\n    }\n  };\n});\n\nreturn leads;"
      },
